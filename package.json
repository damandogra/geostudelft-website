{
  "name": "geostudelft.nl",
  "version": "1.0.1",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack && node ./scripts/postbuild.mjs",
    "start": "next start",
    "analyze": "cross-env ANALYZE=true next build --webpack",
    "lint": "eslint --fix app components data lib scripts",
    "prepare": "husky"
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "@headlessui/react": "2.2.10",
    "@next/bundle-analyzer": "16.4.0",
    "@tailwindcss/forms": "^0.5.9",
    "@tailwindcss/postcss": "^4.0.5",
    "@tailwindcss/typography": "^0.5.15",
    "body-scroll-lock": "^4.0.0-beta.0",
    "contentlayer2": "0.5.8",
    "date-fns": "^4.1.0",
    "hast-util-from-html-isomorphic": "^2.0.0",
    "next": "16.4.0",
    "next-contentlayer2": "0.5.8",
    "next-themes": "^0.4.6",
    "pliny": "0.4.1",
    "postcss": "^8.4.24",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-preset-minify": "7.0.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.0",
    "tailwindcss": "^4.0.5"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "cross-env": "^7.0.3",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.4.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.2.0",
    "husky": "^9.0.0",
    "lint-staged": "^16.4.0",
    "prettier": "^3.0.0",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "typescript": "^5.1.3"
  },
  "lint-staged": {
    "*.+(js|mjs|jsx|ts|tsx)": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.+(json|css|md|mdx)": [
      "prettier --write"
    ]
  },
  "packageManager": "npm@10.9.3"
}
